{
    "extends": "./tsconfig.native.json",
    "compilerOptions": {
        "jsx": "react-jsx",
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "src/*"
            ]
        },
        "lib": [
            "DOM",
            "ES2020"
        ],
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": [
        "src/**/*",
        "public/**/*"
    ]
}
